# Single-container image for Render (see render.yaml).
#
#   Browser ──► Next.js (public, $PORT) ──/api/*──► Django + gunicorn (127.0.0.1:8000, internal only)
#                                                        └──► Selenium + Chromium ──► file:///srv/mock-carrier/index.html
#
# Local development still uses docker-compose.yml; this file is only for one-click cloud deploys.

# ---------- 1) Build the Next.js frontend ----------
FROM node:22-bookworm-slim AS frontend
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
# The browser calls same-origin /api; app/api/[...path]/route.ts forwards it to Django.
ENV NEXT_PUBLIC_API_URL=/api
RUN npm run build

# ---------- 2) Runtime: Python + Chromium + Node ----------
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium chromium-driver fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Node runtime for the Next.js standalone server
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node

WORKDIR /srv/backend
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./

# Demo Express is a self-contained static page, so Selenium can open it straight from disk.
COPY mock-carrier/index.html /srv/mock-carrier/index.html

COPY --from=frontend /app/.next/standalone /srv/frontend
COPY --from=frontend /app/.next/static /srv/frontend/.next/static
COPY --from=frontend /app/public /srv/frontend/public

COPY render-start.sh /srv/render-start.sh
# Strip Windows line endings in case the repo was checked out with CRLF.
RUN sed -i 's/\r$//' /srv/render-start.sh && chmod +x /srv/render-start.sh

ENV PORT=10000
EXPOSE 10000
CMD ["/srv/render-start.sh"]
